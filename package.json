{
  "name": "typora-cn",
  "version": "1.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:editor": "npm --prefix webview-editor install && npm --prefix webview-editor run build",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit && tsc --noEmit -p webview-editor/tsconfig.json",
    "test": "node webview-editor/test/preview.test.mjs && node test/unit.test.mjs && node test/sample-smoke.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~58.0.22",
    "expo": "~58.0.0",
    "expo-asset": "~58.0.19",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "^58.0.10",
    "expo-print": "^58.0.8",
    "expo-sharing": "^58.0.21",
    "expo-status-bar": "~58.0.4",
    "opencc-js": "^1.4.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "~6.0.3"
  }
}
